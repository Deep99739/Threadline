# Local development only. Copy to .env and replace these non-secret defaults as needed.
THREADLINE_ENV=development
THREADLINE_LOG_LEVEL=INFO
THREADLINE_DATABASE_URL=postgresql+psycopg://threadline:threadline_local@localhost:55432/threadline
THREADLINE_REDIS_URL=redis://localhost:56379/0
THREADLINE_OBJECT_STORE_ENDPOINT=http://localhost:59000
THREADLINE_OBJECT_STORE_BUCKET=threadline-local
THREADLINE_OBJECT_STORE_ACCESS_KEY=threadline_local
THREADLINE_OBJECT_STORE_SECRET_KEY=replace_for_nonlocal_use

# External providers are intentionally absent from the local foundation.
# Never place real values in this tracked example file.
